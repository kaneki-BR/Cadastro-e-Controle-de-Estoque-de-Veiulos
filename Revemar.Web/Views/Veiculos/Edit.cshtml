@model Revemar.Domain.Entities.Veiculo

@{
    ViewData["Title"] = "Editar Veículo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3 my-3">
            <div class="card-header bg-warning text-dark p-3">
                <h4 class="mb-0 fw-bold fs-5">
                    <i class="bi bi-pencil-square me-2"></i> Editar Veículo #@Model.Id
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Marca" class="form-label fw-bold"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Modelo" class="form-label fw-bold"></label>
                            <input asp-for="Modelo" class="form-control" />
                            <span asp-validation-for="Modelo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Ano" class="form-label fw-bold"></label>
                            <input asp-for="Ano" class="form-control" type="number" />
                            <span asp-validation-for="Ano" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Cor" class="form-label fw-bold"></label>
                            <input asp-for="Cor" class="form-control" />
                            <span asp-validation-for="Cor" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Preco" class="form-label fw-bold">Preço de Venda</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-success">R$</span>

                                <!-- 1. Campo Visível (Sem asp-for, apenas para exibição da máscara) -->
                                <input type="text"
                                       id="precoDisplay"
                                       class="form-control"
                                       placeholder="0,00"
                                       autocomplete="off"
                                       value="@(Model?.Preco > 0 ? Model.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) : "")" />
                            </div>

                            <!-- 2. campo Ocult (Com asp-for, envia o decimal puro com ponto para o c#) -->
                            <input type="hidden" asp-for="Preco" id="precoReal" />

                            <span asp-validation-for="Preco" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Tipo" class="form-label fw-bold"></label>
                            <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList <Revemar.Domain.Enums.TipoVeiculo>()"></select>
                            <span asp-validation-for="Tipo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Situacao" class="form-label fw-bold"></label>
                            <select asp-for="Situacao" class="form-select" asp-items="Html.GetEnumSelectList<Revemar.Domain.Enums.SituacaoEstoque>()"></select>
                            <span asp-validation-for="Situacao" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const precoDisplay = document.getElementById("precoDisplay");
            const precoReal = document.getElementById("precoReal");

            if (precoDisplay && precoReal) {
                // Ao carregar a página (ex: tela de Edit), garante que o valor oculto esteja atualizado
                if (precoDisplay.value) {
                    atualizarCampos(precoDisplay.value);
                }

                precoDisplay.addEventListener("input", function (e) {
                    atualizarCampos(e.target.value);
                });

                function atualizarCampos(digitos) {
                    // Remove tudo que não é número
                    let valueOnlyDigits = digitos.replace(/\D/g, "");

                    if (valueOnlyDigits === "") {
                        precoDisplay.value = "";
                        precoReal.value = "";
                        return;
                    }

                    // 1. Calcula o valor em decimal (ex: 45000.00) para o C#
                    let rawValue = (parseFloat(valueOnlyDigits) / 100).toFixed(2);

                    // Atualiza o campo OCULTO (que o asp-for usa e o C# recebe)
                    precoReal.value = rawValue;

                    // 2. Campo OCULTO: Substitui ponto por VÍRGULA ("110000,00") para o C# em pt-BR ler corretamente
                    precoReal.value = rawValue.replace(".", ",");

                    // 3. Formata visualmente para o usuário (ex: 45.000,00)
                    precoDisplay.value = rawValue
                        .replace(".", ",")
                        .replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                }
            }
        });                                     
    </script>
}