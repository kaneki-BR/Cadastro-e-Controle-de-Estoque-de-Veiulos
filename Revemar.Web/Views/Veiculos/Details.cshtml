@model Revemar.Domain.Entities.Veiculo

@{
    ViewData["Title"] = "Detalhes do Veículo";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Especificações do Veículo #@Model.Id</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Marca:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Marca</dd>

                    <dt class="col-sm-4 text-muted">Modelo:</dt>
                    <dd class="col-sm-8">@Model.Modelo</dd>

                    <dt class="col-sm-4 text-muted">Ano:</dt>
                    <dd class="col-sm-8">@Model.Ano</dd>

                    <dt class="col-sm-4 text-muted">Cor:</dt>
                    <dd class="col-sm-8">@Model.Cor</dd>

                    <dt class="col-sm-4 text-muted">Tipo de Carroceria:</dt>
                    <dd class="col-sm-8">@Model.Tipo</dd>

                    <dt class="col-sm-4 text-muted">Preço em Estoque:</dt>
                    <dd class="col-sm-8 text-success fw-bold">@Model.Preco.ToString("C")</dd>

                    <dt class="col-sm-4 text-muted">Situação no Estoque:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@Model.Situacao</span>
                    </dd>
                    <hr />

                    <dt class="col-sm-4 text-muted">
                        Data de Cadastro
                    </dt>
                    <dd class="col-sm-8">
                        @Model.DataCadastro.ToString("dd/MM/yyyy 'às' HH:mm")
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        Última Edição no Sistema
                    </dt>
                    <dd class="col-sm-8">
                        @if (Model.DataAtualizacao.HasValue)
                        {
                            <span>@Model.DataAtualizacao.Value.ToString("dd/MM/yyyy 'às' HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-secondary fst-italic">Nunca atualizado</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
            </div>
        </div>
    </div>
</div>